# JWT and registration backend for local Vite development.
API_PROXY_TARGET=http://127.0.0.1:8000

# Public locations backend. Its search parameter currently returns 500, so the
# frontend falls back to fetching the list and filtering it locally.
LOCATIONS_API_TARGET=https://nav-backend-eight.vercel.app

# Direct browser calls require the backend to allow your frontend origin via CORS.
# Keep this unset when using the Vite /api proxy.
# VITE_API_BASE_URL=https://your-cors-enabled-api.example/api
