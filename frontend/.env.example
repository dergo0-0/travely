# Separate Django backend for local Vite development.
API_PROXY_TARGET=http://127.0.0.1:8000

# Keep locations, posts, photos and JWT on the same backend.
LOCATIONS_API_TARGET=http://127.0.0.1:8000

# Direct browser calls require the backend to allow your frontend origin via CORS.
# Keep this unset when using the Vite /api proxy.
# VITE_API_BASE_URL=https://your-cors-enabled-api.example/api
